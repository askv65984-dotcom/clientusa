# Public URL of the site, no trailing slash. Use http://localhost:3000 for local development.
NEXT_PUBLIC_SITE_URL=https://anokaadvisors.com

# Supabase (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (or legacy service_role key). Server only, never expose it.
SUPABASE_SECRET_KEY=

# Admin sign-in. Visitors only type the PIN; the server uses these to start the admin session.
# ADMIN_PASSWORD is a long random password for the info@ account in Supabase Auth. Never share it.
ADMIN_EMAIL=info@anokaadvisors.com
ADMIN_PASSWORD=

# Stripe (Developers > API keys). Use sk_test_ keys until you are ready to go live.
STRIPE_SECRET_KEY=
# Signing secret for the webhook endpoint pointing at /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Only needed to re-download photos with scripts/fetch-images.mjs
PEXELS_API_KEY=

# Optional
# BUSINESS_TIME_ZONE=America/Chicago
# GOOGLE_SITE_VERIFICATION=
